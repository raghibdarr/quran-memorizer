{
  "id": 104,
  "nameSimple": "Al-Humazah",
  "nameArabic": "الهمزة",
  "nameTranslation": "The Traducer",
  "revelationPlace": "makkah",
  "versesCount": 9,
  "ayahs": [
    {
      "number": 1,
      "key": "104:1",
      "textUthmani": "وَيْلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةٍ",
      "textUthmaniTajweed": "وَيْ<tajweed class=idgham_wo_ghunnah>لٌ لِّ</tajweed>كُلِّ هُمَزَ<tajweed class=idgham_wo_ghunnah>ةٍ لُّ</tajweed>مَزَةٍ <span class=end>۝١</span>",
      "textIndopak": "وَيْلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةِ ۙ",
      "words": [
        {
          "position": 1,
          "textUthmani": "وَيْلٌۭ",
          "transliteration": "waylun",
          "translation": "Woe",
          "charType": "word"
        },
        {
          "position": 2,
          "textUthmani": "لِّكُلِّ",
          "transliteration": "likulli",
          "translation": "to every",
          "charType": "word"
        },
        {
          "position": 3,
          "textUthmani": "هُمَزَةٍۢ",
          "transliteration": "humazatin",
          "translation": "slanderer",
          "charType": "word"
        },
        {
          "position": 4,
          "textUthmani": "لُّمَزَةٍ",
          "transliteration": "lumazatin",
          "translation": "backbiter",
          "charType": "word"
        },
        {
          "position": 5,
          "textUthmani": "١",
          "transliteration": null,
          "translation": "(1)",
          "charType": "end"
        }
      ],
      "translation": "Woe to every scorner and mocker",
      "transliteration": "Wailul likulli hu-mazatil lumazah",
      "audioUrl": "https://everyayah.com/data/Alafasy_128kbps/104001.mp3",
      "translationClear": "Woe to every slanderer backbiter."
    },
    {
      "number": 2,
      "key": "104:2",
      "textUthmani": "ٱلَّذِى جَمَعَ مَالًا وَعَدَّدَهُۥ",
      "textUthmaniTajweed": "ٱلَّذِى جَمَعَ مَا<tajweed class=idgham_ghunnah>لًا وَ</tajweed>عَدَّدَهُۥ <span class=end>۝٢</span>",
      "textIndopak": "اࣙلَّذِيْ جَمَعَ مَالًا وَّعَدَّدَهٗ ۙ",
      "words": [
        {
          "position": 1,
          "textUthmani": "ٱلَّذِى",
          "transliteration": "alladhī",
          "translation": "The one who",
          "charType": "word"
        },
        {
          "position": 2,
          "textUthmani": "جَمَعَ",
          "transliteration": "jamaʿa",
          "translation": "collects",
          "charType": "word"
        },
        {
          "position": 3,
          "textUthmani": "مَالًۭا",
          "transliteration": "mālan",
          "translation": "wealth",
          "charType": "word"
        },
        {
          "position": 4,
          "textUthmani": "وَعَدَّدَهُۥ",
          "transliteration": "waʿaddadahu",
          "translation": "and counts it",
          "charType": "word"
        },
        {
          "position": 5,
          "textUthmani": "٢",
          "transliteration": null,
          "translation": "(2)",
          "charType": "end"
        }
      ],
      "translation": "Who collects wealth and [continuously] counts it.[1987]",
      "transliteration": "Allathee jama'a maalanw Wa-'addadah",
      "audioUrl": "https://everyayah.com/data/Alafasy_128kbps/104002.mp3",
      "footnotes": {
        "1987": "Rather than spending in the way of Allāh."
      },
      "translationClear": "Who gathers wealth and counts it over."
    },
    {
      "number": 3,
      "key": "104:3",
      "textUthmani": "يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ",
      "textUthmaniTajweed": "يَحْسَبُ أَ<tajweed class=ghunnah>نَّ</tajweed> مَالَهُ<tajweed class=madda_obligatory>ۥٓ</tajweed> أَخْلَدَهُۥ <span class=end>۝٣</span>",
      "textIndopak": "يَحْسَبُ اَنَّ مَالَهٗٓ اَخْلَدَهٗ ۚ",
      "words": [
        {
          "position": 1,
          "textUthmani": "يَحْسَبُ",
          "transliteration": "yaḥsabu",
          "translation": "Thinking",
          "charType": "word"
        },
        {
          "position": 2,
          "textUthmani": "أَنَّ",
          "transliteration": "anna",
          "translation": "that",
          "charType": "word"
        },
        {
          "position": 3,
          "textUthmani": "مَالَهُۥٓ",
          "transliteration": "mālahu",
          "translation": "his wealth",
          "charType": "word"
        },
        {
          "position": 4,
          "textUthmani": "أَخْلَدَهُۥ",
          "transliteration": "akhladahu",
          "translation": "will make him immortal",
          "charType": "word"
        },
        {
          "position": 5,
          "textUthmani": "٣",
          "transliteration": null,
          "translation": "(3)",
          "charType": "end"
        }
      ],
      "translation": "He thinks that his wealth will make him immortal.",
      "transliteration": "Yahsabu anna maalahooo akhladah",
      "audioUrl": "https://everyayah.com/data/Alafasy_128kbps/104003.mp3",
      "translationClear": "Thinking that his wealth has made him immortal."
    },
    {
      "number": 4,
      "key": "104:4",
      "textUthmani": "كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ",
      "textUthmaniTajweed": "كَلَّا‌ۖ لَيُ<tajweed class=iqlab>نۢبَ</tajweed>ذَ<tajweed class=ghunnah>نَّ</tajweed> فِى <tajweed class=ham_wasl>ٱ</tajweed>لْحُطَمَةِ <span class=end>۝٤</span>",
      "textIndopak": "كَلَّا لَيُنۢ͏ْبَذَنَّ فِي الْحُطَمَةِ ؗۖ",
      "words": [
        {
          "position": 1,
          "textUthmani": "كَلَّا ۖ",
          "transliteration": "kallā",
          "translation": "Nay",
          "charType": "word"
        },
        {
          "position": 2,
          "textUthmani": "لَيُنۢبَذَنَّ",
          "transliteration": "layunbadhanna",
          "translation": "Surely he will be thrown",
          "charType": "word"
        },
        {
          "position": 3,
          "textUthmani": "فِى",
          "transliteration": "fī",
          "translation": "in",
          "charType": "word"
        },
        {
          "position": 4,
          "textUthmani": "ٱلْحُطَمَةِ",
          "transliteration": "l-ḥuṭamati",
          "translation": "the Crusher",
          "charType": "word"
        },
        {
          "position": 5,
          "textUthmani": "٤",
          "transliteration": null,
          "translation": "(4)",
          "charType": "end"
        }
      ],
      "translation": "No! He will surely be thrown into the Crusher.[1988]",
      "transliteration": "Kallaa; layumbathanna fil hutamah",
      "audioUrl": "https://everyayah.com/data/Alafasy_128kbps/104004.mp3",
      "footnotes": {
        "1988": "i.e., Hellfire, which crushes and destroys all that enters it."
      },
      "translationClear": "By no means. He will be thrown into the Crusher."
    },
    {
      "number": 5,
      "key": "104:5",
      "textUthmani": "وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ",
      "textUthmaniTajweed": "وَمَ<tajweed class=madda_obligatory>آ</tajweed> أَ<tajweed class=qalaqah>دْ</tajweed>رَى<tajweed class=madda_normal>ٰ</tajweed>كَ مَا <tajweed class=ham_wasl>ٱ</tajweed>لْحُطَمَةُ <span class=end>۝٥</span>",
      "textIndopak": "وَمَا͏ٓ اَدْرٰىكَ مَا الْحُطَمَةُ ؕ",
      "words": [
        {
          "position": 1,
          "textUthmani": "وَمَآ",
          "transliteration": "wamā",
          "translation": "And what",
          "charType": "word"
        },
        {
          "position": 2,
          "textUthmani": "أَدْرَىٰكَ",
          "transliteration": "adrāka",
          "translation": "will make you know",
          "charType": "word"
        },
        {
          "position": 3,
          "textUthmani": "مَا",
          "transliteration": "mā",
          "translation": "what",
          "charType": "word"
        },
        {
          "position": 4,
          "textUthmani": "ٱلْحُطَمَةُ",
          "transliteration": "l-ḥuṭamatu",
          "translation": "the Crusher (is)",
          "charType": "word"
        },
        {
          "position": 5,
          "textUthmani": "٥",
          "transliteration": null,
          "translation": "(5)",
          "charType": "end"
        }
      ],
      "translation": "And what can make you know what is the Crusher?",
      "transliteration": "Wa-maa adraaka mal hutamah",
      "audioUrl": "https://everyayah.com/data/Alafasy_128kbps/104005.mp3",
      "translationClear": "And what will make you realize what the Crusher is?"
    },
    {
      "number": 6,
      "key": "104:6",
      "textUthmani": "نَارُ ٱللَّهِ ٱلْمُوقَدَةُ",
      "textUthmaniTajweed": "نَارُ <tajweed class=ham_wasl>ٱ</tajweed>للَّهِ <tajweed class=ham_wasl>ٱ</tajweed>لْمُوقَدَةُ <span class=end>۝٦</span>",
      "textIndopak": "نَارُ اللّٰهِ الْمُوْقَدَةُ ۙ",
      "words": [
        {
          "position": 1,
          "textUthmani": "نَارُ",
          "transliteration": "nāru",
          "translation": "A Fire",
          "charType": "word"
        },
        {
          "position": 2,
          "textUthmani": "ٱللَّهِ",
          "transliteration": "l-lahi",
          "translation": "Allah",
          "charType": "word"
        },
        {
          "position": 3,
          "textUthmani": "ٱلْمُوقَدَةُ",
          "transliteration": "l-mūqadatu",
          "translation": "kindled",
          "charType": "word"
        },
        {
          "position": 4,
          "textUthmani": "٦",
          "transliteration": null,
          "translation": "(6)",
          "charType": "end"
        }
      ],
      "translation": "It is the fire of Allāh, [eternally] fueled,",
      "transliteration": "Naarul laahil mooqada",
      "audioUrl": "https://everyayah.com/data/Alafasy_128kbps/104006.mp3",
      "translationClear": "Allah’s kindled Fire."
    },
    {
      "number": 7,
      "key": "104:7",
      "textUthmani": "ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ",
      "textUthmaniTajweed": "ٱلَّتِى تَطَّلِعُ عَلَى <tajweed class=ham_wasl>ٱ</tajweed>لْأَفْـِٔدَةِ <span class=end>۝٧</span>",
      "textIndopak": "الَّتِيْ تَطَّلِعُ عَلَي الْاَفْـِٕدَةِ ؕ",
      "words": [
        {
          "position": 1,
          "textUthmani": "ٱلَّتِى",
          "transliteration": "allatī",
          "translation": "Which",
          "charType": "word"
        },
        {
          "position": 2,
          "textUthmani": "تَطَّلِعُ",
          "transliteration": "taṭṭaliʿu",
          "translation": "mounts up",
          "charType": "word"
        },
        {
          "position": 3,
          "textUthmani": "عَلَى",
          "transliteration": "ʿalā",
          "translation": "to",
          "charType": "word"
        },
        {
          "position": 4,
          "textUthmani": "ٱلْأَفْـِٔدَةِ",
          "transliteration": "l-afidati",
          "translation": "the hearts",
          "charType": "word"
        },
        {
          "position": 5,
          "textUthmani": "٧",
          "transliteration": null,
          "translation": "(7)",
          "charType": "end"
        }
      ],
      "translation": "Which mounts directed at the hearts.[1989]",
      "transliteration": "Allatee tattali'u 'alal af'idah",
      "audioUrl": "https://everyayah.com/data/Alafasy_128kbps/104007.mp3",
      "footnotes": {
        "1989": "Covering them and penetrating them."
      },
      "translationClear": "That laps to the hearts."
    },
    {
      "number": 8,
      "key": "104:8",
      "textUthmani": "إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌ",
      "textUthmaniTajweed": "إِ<tajweed class=ghunnah>نَّ</tajweed>هَا عَلَيْهِ<tajweed class=idgham_shafawi>م مُّ</tajweed>ؤْصَدَةٌ <span class=end>۝٨</span>",
      "textIndopak": "اِنَّهَا عَلَيْهِمْ مُّو͏ٔ͏ْصَدَةٌ ۙ",
      "words": [
        {
          "position": 1,
          "textUthmani": "إِنَّهَا",
          "transliteration": "innahā",
          "translation": "Indeed, it",
          "charType": "word"
        },
        {
          "position": 2,
          "textUthmani": "عَلَيْهِم",
          "transliteration": "ʿalayhim",
          "translation": "(will be) upon them",
          "charType": "word"
        },
        {
          "position": 3,
          "textUthmani": "مُّؤْصَدَةٌۭ",
          "transliteration": "mu'ṣadatun",
          "translation": "closed over",
          "charType": "word"
        },
        {
          "position": 4,
          "textUthmani": "٨",
          "transliteration": null,
          "translation": "(8)",
          "charType": "end"
        }
      ],
      "translation": "Indeed, it [i.e., Hellfire] will be closed down upon them",
      "transliteration": "Innahaa 'alaihim mu'sada",
      "audioUrl": "https://everyayah.com/data/Alafasy_128kbps/104008.mp3",
      "translationClear": "It closes in on them."
    },
    {
      "number": 9,
      "key": "104:9",
      "textUthmani": "فِى عَمَدٍ مُّمَدَّدَةٍۭ",
      "textUthmaniTajweed": "فِى عَمَ<tajweed class=idgham_ghunnah>دٍ مُّ</tajweed>مَدَّدَةٍۭ <span class=end>۝٩</span>",
      "textIndopak": "فِيْ عَمَدٍ مُّمَدَّدَةٍ ࣖ",
      "words": [
        {
          "position": 1,
          "textUthmani": "فِى",
          "transliteration": "fī",
          "translation": "In",
          "charType": "word"
        },
        {
          "position": 2,
          "textUthmani": "عَمَدٍۢ",
          "transliteration": "ʿamadin",
          "translation": "columns",
          "charType": "word"
        },
        {
          "position": 3,
          "textUthmani": "مُّمَدَّدَةٍۭ",
          "transliteration": "mumaddadatin",
          "translation": "extended",
          "charType": "word"
        },
        {
          "position": 4,
          "textUthmani": "٩",
          "transliteration": null,
          "translation": "(9)",
          "charType": "end"
        }
      ],
      "translation": "In extended columns.[1990]",

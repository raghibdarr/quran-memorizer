          "textUthmani": "٨",
          "transliteration": null,
          "translation": "(8)",
          "charType": "end"
        }
      ],
      "translation": "And to your Lord direct [your] longing.",
      "transliteration": "Wa-ilaa rabbika far-ghab",
      "audioUrl": "https://everyayah.com/data/Alafasy_128kbps/094008.mp3",

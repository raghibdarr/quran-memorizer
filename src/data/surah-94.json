      "textIndopak": "الَّذِىۡۤ اَنۡقَضَ ظَهۡرَكَۙ‏",
      "words": [
        {
          "position": 1,
          "textUthmani": "ٱلَّذِىٓ",
          "transliteration": "alladhī",
          "translation": "Which",
          "charType": "word"
        },
        {
          "position": 2,
          "textUthmani": "أَنقَضَ",
          "transliteration": "anqaḍa",
          "translation": "weighed upon",
          "charType": "word"
        },
        {
          "position": 3,
          "textUthmani": "ظَهْرَكَ",
          "transliteration": "ẓahraka",
          "translation": "your back",
          "charType": "word"
        },
        {
          "position": 4,
          "textUthmani": "٣",
          "transliteration": null,
          "translation": "(3)",
          "charType": "end"
        }
      ],
      "translation": "Which had weighed upon your back",
      "transliteration": "Allathee anqada zahrak",
      "audioUrl": "https://everyayah.com/data/Alafasy_128kbps/094003.mp3",
      "translationClear": "Which weighed down your back?"
    },
    {
      "number": 4,
      "key": "94:4",
      "textUthmani": "وَرَفَعْنَا لَكَ ذِكْرَكَ",
      "textUthmaniTajweed": "وَرَفَعْنَا لَكَ ذِكْرَكَ <span class=end>۝٤</span>",
      "textIndopak": "وَرَفَعۡنَا لَـكَ ذِكۡرَكَؕ‏",
      "words": [
        {
          "position": 1,
          "textUthmani": "وَرَفَعْنَا",
          "transliteration": "warafaʿnā",
          "translation": "And We raised high",
          "charType": "word"
        },
        {
          "position": 2,
          "textUthmani": "لَكَ",
          "transliteration": "laka",
          "translation": "for you",
          "charType": "word"
        },
        {
          "position": 3,
          "textUthmani": "ذِكْرَكَ",
          "transliteration": "dhik'raka",
          "translation": "your reputation",
          "charType": "word"
        },
        {
          "position": 4,
          "textUthmani": "٤",
          "transliteration": null,
          "translation": "(4)",
          "charType": "end"
        }
      ],
      "translation": "And raised high for you your repute.",
      "transliteration": "Wa-raf-'ana laka thikrak",
      "audioUrl": "https://everyayah.com/data/Alafasy_128kbps/094004.mp3",
      "translationClear": "And raised for you your reputation?"
    },
    {
      "number": 5,
      "key": "94:5",
      "textUthmani": "فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا",
      "textUthmaniTajweed": "فَإِ<tajweed class=ghunnah>نَّ</tajweed> مَعَ <tajweed class=ham_wasl>ٱ</tajweed>لْعُسْرِ يُسْرًا <span class=end>۝٥</span>",
      "textIndopak": "فَاِنَّ مَعَ الۡعُسۡرِ يُسۡرًا ۙ‏",
      "words": [
        {
          "position": 1,
          "textUthmani": "فَإِنَّ",
          "transliteration": "fa-inna",
          "translation": "So indeed",
          "charType": "word"
        },
        {
          "position": 2,
          "textUthmani": "مَعَ",
          "transliteration": "maʿa",
          "translation": "with",
          "charType": "word"
        },
        {
          "position": 3,
          "textUthmani": "ٱلْعُسْرِ",
          "transliteration": "l-ʿus'ri",
          "translation": "the hardship",
          "charType": "word"
        },
        {
          "position": 4,
          "textUthmani": "يُسْرًا",
          "transliteration": "yus'ran",
          "translation": "(is) ease",
          "charType": "word"
        },
        {
          "position": 5,
          "textUthmani": "٥",
          "transliteration": null,
          "translation": "(5)",
          "charType": "end"
        }
      ],
      "translation": "For indeed, with hardship [will be] ease [i.e., relief].",
      "transliteration": "Fa-inna ma'al usri yusra",
      "audioUrl": "https://everyayah.com/data/Alafasy_128kbps/094005.mp3",
      "translationClear": "With hardship comes ease."
    },
    {
      "number": 6,
      "key": "94:6",
      "textUthmani": "إِنَّ مَعَ ٱلْعُسْرِ يُسْرًا",
      "textUthmaniTajweed": "إِ<tajweed class=ghunnah>نَّ</tajweed> مَعَ <tajweed class=ham_wasl>ٱ</tajweed>لْعُسْرِ يُسْرًا <span class=end>۝٦</span>",
      "textIndopak": "اِنَّ مَعَ الۡعُسۡرِ يُسۡرًا ؕ‏",
      "words": [
        {
          "position": 1,
          "textUthmani": "إِنَّ",
          "transliteration": "inna",
          "translation": "Indeed",
          "charType": "word"
        },
        {
          "position": 2,
          "textUthmani": "مَعَ",
          "transliteration": "maʿa",
          "translation": "with",
          "charType": "word"
        },
        {
          "position": 3,
          "textUthmani": "ٱلْعُسْرِ",
          "transliteration": "l-ʿus'ri",
          "translation": "the hardship",
          "charType": "word"
        },
        {
          "position": 4,
          "textUthmani": "يُسْرًۭا",
          "transliteration": "yus'ran",
          "translation": "(is) ease",
          "charType": "word"
        },
        {
          "position": 5,
          "textUthmani": "٦",
          "transliteration": null,
          "translation": "(6)",
          "charType": "end"
        }
      ],
      "translation": "Indeed, with hardship [will be] ease.",
      "transliteration": "Inna ma'al 'usri yusra",
      "audioUrl": "https://everyayah.com/data/Alafasy_128kbps/094006.mp3",
      "translationClear": "With hardship comes ease."
    },
    {
      "number": 7,
      "key": "94:7",
      "textUthmani": "فَإِذَا فَرَغْتَ فَٱنصَبْ",
      "textUthmaniTajweed": "فَإِذَا فَرَغْتَ فَ<tajweed class=ham_wasl>ٱ</tajweed><tajweed class=ikhafa>نصَ</tajweed><tajweed class=qalaqah>بْ</tajweed> <span class=end>۝٧</span>",
      "textIndopak": "فَاِذَا فَرَغۡتَ فَانۡصَبۡۙ‏",
      "words": [
        {
          "position": 1,
          "textUthmani": "فَإِذَا",
          "transliteration": "fa-idhā",
          "translation": "So when",
          "charType": "word"
        },
        {
          "position": 2,
          "textUthmani": "فَرَغْتَ",
          "transliteration": "faraghta",
          "translation": "you have finished",
          "charType": "word"
        },
        {
          "position": 3,
          "textUthmani": "فَٱنصَبْ",
          "transliteration": "fa-inṣab",
          "translation": "then labor hard",
          "charType": "word"
        },
        {
          "position": 4,
          "textUthmani": "٧",
          "transliteration": null,
          "translation": "(7)",
          "charType": "end"
        }
      ],
      "translation": "So when you have finished [your duties], then stand up [for worship].",
      "transliteration": "Fa-itha faragh-ta fansab",
      "audioUrl": "https://everyayah.com/data/Alafasy_128kbps/094007.mp3",
      "translationClear": "When your work is done, turn to devotion."
    },
    {
      "number": 8,
      "key": "94:8",
      "textUthmani": "وَإِلَىٰ رَبِّكَ فَٱرْغَب",
      "textUthmaniTajweed": "وَإِلَىٰ رَبِّكَ فَ<tajweed class=ham_wasl>ٱ</tajweed>رْغَ<tajweed class=qalaqah>ب</tajweed> <span class=end>۝٨</span>",
      "textIndopak": "وَاِلٰى رَبِّكَ فَارۡغَب‏",
      "words": [
        {
          "position": 1,
          "textUthmani": "وَإِلَىٰ",
          "transliteration": "wa-ilā",
          "translation": "And to",
          "charType": "word"
        },
        {
          "position": 2,
          "textUthmani": "رَبِّكَ",
          "transliteration": "rabbika",
          "translation": "your Lord",
          "charType": "word"
        },
        {
          "position": 3,
          "textUthmani": "فَٱرْغَب",
          "transliteration": "fa-ir'ghab",
          "translation": "turn your attention",
